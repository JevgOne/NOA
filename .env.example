# Zkopíruj do .env.local (lokálně) a nastav stejné hodnoty na Vercelu
# (Settings -> Environment Variables). NIKDY necommituj reálné hodnoty do gitu.

# Turso (libSQL) databáze pro recenze — viz README.
TURSO_DATABASE_URL=libsql://...turso.io
TURSO_AUTH_TOKEN=

# Tajný klíč pro moderaci recenzí: /admin/recenze?key=...
ADMIN_KEY=
